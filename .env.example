# Database
DATABASE_URL="postgresql://closeros:closeros_dev_password@localhost:5432/closeros_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# S3 / MinIO (Local Development)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_RECORDINGS="closeros-recordings"
S3_BUCKET_DOCUMENTS="closeros-documents"
S3_REGION="us-east-1"

# AWS S3 (Production - comment out MinIO settings above)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# S3_BUCKET_RECORDINGS="closeros-prod-recordings"
# S3_BUCKET_DOCUMENTS="closeros-prod-documents"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# API
API_PORT=3001
API_HOST="localhost"
NODE_ENV="development"
API_URL="http://localhost:3001"

# Web App
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# Landing Page
NEXT_PUBLIC_LANDING_URL="http://localhost:3002"

# Daily.co (WebRTC)
DAILY_API_KEY=""
DAILY_DOMAIN=""
# Use mock mode for development without Daily.co account
DAILY_MOCK_MODE="true"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Anthropic (Alternative to OpenAI)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Deepgram (Speech-to-Text)
DEEPGRAM_API_KEY=""
# Use mock mode for development
DEEPGRAM_MOCK_MODE="true"

# Pinecone (Vector Database - Production)
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME="closeros-embeddings"
# Use local pgvector for development
USE_PGVECTOR="true"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Use test mode for development
STRIPE_TEST_MODE="true"

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
# Use mock mode for development
TWILIO_MOCK_MODE="true"

# Google Calendar
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/calendar/google/callback"

# Microsoft Outlook Calendar
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_REDIRECT_URI="http://localhost:3001/api/calendar/outlook/callback"

# Email (SendGrid or similar)
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@closeros.com"
EMAIL_MOCK_MODE="true"

# Security
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"
RATE_LIMIT_TTL="60"
RATE_LIMIT_LIMIT="100"

# Monitoring & Observability
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Feature Flags
ENABLE_2FA="true"
ENABLE_REAL_TIME_WHISPER="false"
ENABLE_CALL_RECORDING="true"

# AI Service
AI_SERVICE_URL="http://localhost:8000"
AI_WORKER_CONCURRENCY="2"

# Job Queue
BULL_BOARD_USERNAME="admin"
BULL_BOARD_PASSWORD="admin"

# Logging
LOG_LEVEL="debug"
